{
  // These are docs and templates. Keep the rules that catch structural
  // breakage (heading levels, link/reference syntax, list-marker consistency,
  // duplicate anchors) and drop the whitespace pedantry that fights ordinary
  // authoring - HTML-comment preambles in templates, tight instruction lists.
  "config": {
    "MD009": false, // trailing spaces
    "MD012": false, // multiple blank lines
    "MD013": false, // line length
    "MD022": false, // blanks around headings
    "MD024": { "siblings_only": true }, // repeated headings ok across sections
    "MD031": false, // blanks around fenced code
    "MD032": false, // blanks around lists
    "MD033": false, // inline HTML (templates use <!-- --> guidance comments)
    "MD040": false, // language on every fence (many are shell snippets in prose)
    "MD041": false, // first line need not be a heading
    "MD046": false, // code block style
    "MD060": false  // table pipe padding style
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", ".workflow"]
}
